package com.smartforum.desktop.service;

import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.*;

/**
 * Local file-based cache manager for offline data persistence.
 * Replaces SQLite with simple JSON files stored in ~/.smart-forum-desktop/
 * as specified in the SDD dual-database storage strategy.
 */
public class CacheManager {
    private final Path dataDir;

    public CacheManager() {
        this.dataDir = Path.of(System.getProperty("user.home"), ".smart-forum-desktop");
        try { Files.createDirectories(dataDir); } catch (IOException ignored) {}
    }

    public Path getDataDir() { return dataDir; }

    // ---- Session persistence ----
    public void saveSession(String baseUrl, String token) {
        Properties p = new Properties();
        p.setProperty("baseUrl", baseUrl);
        p.setProperty("token", token != null ? token : "");
        try { p.store(Files.newOutputStream(dataDir.resolve("session.properties")), "Smart Forum Desktop Session"); }
        catch (IOException ignored) {}
    }

    public String[] loadSession() {
        Properties p = new Properties();
        try { p.load(Files.newInputStream(dataDir.resolve("session.properties"))); }
        catch (IOException ignored) { return new String[]{"http://127.0.0.1:8000", null}; }
        return new String[]{p.getProperty("baseUrl", "http://127.0.0.1:8000"), p.getProperty("token", null)};
    }

    public void clearSession() {
        try { Files.deleteIfExists(dataDir.resolve("session.properties")); }
        catch (IOException ignored) {}
    }

    // ---- Generic cache helpers ----
    public void cache(String name, String value) {
        try { Files.writeString(dataDir.resolve(name), value, StandardCharsets.UTF_8); }
        catch (IOException ignored) {}
    }

    public Map<String, Object> fromCache(String name) {
        try { return ApiClient.Json.object(ApiClient.Json.read(Files.readString(dataDir.resolve(name)))); }
        catch (Exception ignored) { return new LinkedHashMap<>(); }
    }

    public List<Map<String, Object>> listFromCache(String name) {
        try {
            Object parsed = ApiClient.Json.read(Files.readString(dataDir.resolve(name)));
            return castList(parsed);
        } catch (Exception ignored) { return new ArrayList<>(); }
    }

    // ---- Offline pending replies queue ----
    public void enqueuePendingReply(Map<String, Object> reply) {
        List<Map<String, Object>> pending = getPendingReplies();
        pending.add(reply);
        savePendingReplies(pending);
    }

    public List<Map<String, Object>> getPendingReplies() {
        try {
            String content = Files.readString(dataDir.resolve("pending-replies.json"));
            Map<String, Object> root = ApiClient.Json.object(ApiClient.Json.read(content));
            return castList(root.get("replies"));
        } catch (Exception ignored) { return new ArrayList<>(); }
    }

    public void savePendingReplies(List<Map<String, Object>> replies) {
        cache("pending-replies.json", ApiClient.Json.write(Map.of("replies", replies)));
    }

    public int getPendingCount() {
        return getPendingReplies().size();
    }

    // ---- Cached data accessors ----
    public List<Map<String, Object>> getCachedGroups() {
        return castList(fromCache("groups.json").get("groups"));
    }

    public void cacheGroups(List<Map<String, Object>> groups) {
        cache("groups.json", ApiClient.Json.write(Map.of("groups", groups)));
    }

    public List<Map<String, Object>> getCachedTopics(long groupId) {
        return listFromCache("topics-" + groupId + ".json");
    }

    public void cacheTopics(long groupId, List<Map<String, Object>> topics) {
        cache("topics-" + groupId + ".json", ApiClient.Json.write(Map.of("topics", Map.of("data", topics))));
    }

    public List<Map<String, Object>> getCachedMessages(long topicId) {
        return listFromCache("messages-" + topicId + ".json");
    }

    public void cacheMessages(long topicId, List<Map<String, Object>> messages) {
        cache("messages-" + topicId + ".json", ApiClient.Json.write(Map.of("messages", messages)));
    }

    public Map<String, Object> getCachedBootstrap() {
        return fromCache("desktop-bootstrap.json");
    }

    public void cacheBootstrap(Map<String, Object> data) {
        cache("desktop-bootstrap.json", ApiClient.Json.write(data));
    }

    @SuppressWarnings("unchecked")
    private List<Map<String, Object>> castList(Object value) {
        List<Map<String, Object>> result = new ArrayList<>();
        if (value instanceof List<?> list) {
            for (Object item : list) {
                if (item instanceof Map<?, ?> m) {
                    result.add((Map<String, Object>) m);
                }
            }
        }
        return result;
    }
}